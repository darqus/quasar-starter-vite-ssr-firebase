# Public application metadata
VITE_NAME_FULL=quasar-starter-vite-ssr-firebase
VITE_NAME_SHORT=qsvsf
VITE_DESCRIPTION=Based on Vue 3 + vite, quasar, pinia, firebase

VITE_API_PROTOCOL=http:
VITE_API_DOMAIN=10.0.12.209
VITE_API_PORT=8581
VITE_API_HOST=${VITE_API_PROTOCOL}//${VITE_API_DOMAIN}:${VITE_API_PORT}
VITE_API_VERSION=1
VITE_API_BASE_URL=${VITE_API_HOST}/api/v${VITE_API_VERSION}/

VITE_ROUTER_MODE=history
VITE_ROUTER_BASE=/

# Theme: auto | true | false
VITE_DARK=auto

# Firebase web config: copy this file to .env.local and fill in your values.
# .env.local is ignored by git and is never committed.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
