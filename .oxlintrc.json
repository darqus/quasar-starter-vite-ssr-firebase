{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.quasar/**",
    "**/.firebase/**",
    "**/*.min.*",
    "**/*.log"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/curly": "error",
    "eslint/eqeqeq": ["error", "smart"],
    "eslint/no-debugger": "error",
    "eslint/no-console": ["warn", { "allow": ["warn", "error"] }],
    "eslint/no-param-reassign": ["error", { "props": false }],
    "eslint/no-unused-expressions": "error",
    "eslint/no-underscore-dangle": [
      "warn",
      { "allow": ["__APP_VERSION__", "__BUILD_DATE__"] }
    ],
    "eslint/no-var": "error",
    "eslint/object-shorthand": ["error", "always"],
    "eslint/prefer-const": ["error", { "destructuring": "all" }],
    "eslint/prefer-destructuring": ["warn", { "array": false, "object": true }],
    "eslint/prefer-template": "warn",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": "allow-with-description",
        "ts-nocheck": "allow-with-description",
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-empty-interface": ["error", { "allowSingleExtends": true }],
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-floating-promises": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-readonly": "warn",
    "typescript/restrict-template-expressions": [
      "warn",
      { "allowNumber": true }
    ],
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "eslint/no-console": "off",
        "eslint/prefer-destructuring": "off"
      }
    }
  ]
}
